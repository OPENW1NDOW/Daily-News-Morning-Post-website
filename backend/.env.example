# JWT 签名密钥（生产必填，用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成）
# 不配置则每次重启生成临时密钥，重启后所有登录失效
JWT_SECRET=

# LLM API 密钥（必填）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM API 地址（根据你使用的模型服务商填写）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（根据你使用的模型填写，如 deepseek-chat、gpt-4o-mini 等）
LLM_MODEL=deepseek-chat

# HTTP 代理地址（海外 RSS 源拉取用，端口改为你代理工具的实际端口）
PROXY_URL=http://127.0.0.1:7897

# RSSHub 实例地址（本地开发用 localhost:1200，生产环境用 Docker 内部地址）
RSSHUB_BASE_URL=http://localhost:1200

# 是否自动启动本地 RSSHub 实例（设为 false 则跳过，需手动启动）
RSSHUB_AUTO_START=true

# RSSHub 项目目录（留空则默认为 backend/../rsshub）
RSSHUB_DIR=

# SQLite 数据文件路径（通常无需修改）
DATABASE_URL=sqlite:///./data/news.db

# X / bird（Following 旁路）
# Cookie：浏览器 Application → Cookies → x.com 的 auth_token / ct0
# 命令行手动测 bird 时，除 AUTH_TOKEN/CT0 外还须：
#   $env:NODE_USE_ENV_PROXY="1"
#   $env:HTTPS_PROXY="http://127.0.0.1:7897"   # 与 PROXY_URL 一致
# （Node fetch 默认不走系统代理；浏览器能开 x.com 不代表 bird 能连）
# Windows 本地若同步报 WinError 2：把 BIRD_BIN 设为 bird.cmd 绝对路径，例如
# BIRD_BIN=C:\Users\你的用户名\AppData\Roaming\npm\bird.cmd
X_AUTH_TOKEN=
X_CT0=
BIRD_BIN=bird
X_FOLLOWING_CANDIDATE_TOP_N=8

