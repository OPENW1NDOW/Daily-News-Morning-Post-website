# 生产环境配置模板（服务器上复制为 backend/.env 后填入真实值）
# cp backend/.env.production.example backend/.env

# LLM API 密钥（必填，从 DeepSeek 开放平台 https://platform.deepseek.com 申请）
LLM_API_KEY=

# LLM API 地址
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
LLM_MODEL=deepseek-chat

# HTTP 代理地址（海外 RSS 源拉取用；容器内通过 host.docker.internal 访问宿主机代理，
# 宿主机未跑代理则留空，海外源会拉取失败但不影响国内源）
PROXY_URL=http://host.docker.internal:7897

# RSSHub 实例地址（生产走 Docker 内部网络的 rsshub 容器）
RSSHUB_BASE_URL=http://rsshub:1200

# 生产由 docker-compose 管理 rsshub 容器，禁止后端自行拉起本地实例
RSSHUB_AUTO_START=false

# RSSHub 项目目录（生产不用，留空）
RSSHUB_DIR=

# SQLite 数据文件路径（容器内绝对路径，对应 sqlite-data 数据卷挂载点 /app/data）
DATABASE_URL=sqlite:////app/data/news.db

# JWT 签名密钥（生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"）
# 注意：当前代码在 app/api/deps.py 硬编码了 SECRET_KEY，改为读取此环境变量后本值才生效
JWT_SECRET=

# X / bird（Following 旁路）
# 来源：浏览器 Application → Cookies → x.com 的 auth_token / ct0，不用此功能可留空
X_AUTH_TOKEN=
X_CT0=
BIRD_BIN=bird
X_FOLLOWING_CANDIDATE_TOP_N=8
